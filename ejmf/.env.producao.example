# EJMF — variáveis de produção (copie para .env.producao, que NUNCA vai para o Git). Nada aqui é valor real.
# Depois de preencher: docker compose -f docker-compose.producao.yml --env-file .env.producao run --rm api python -m app.cli verificar-producao

# Domínio e certificado (o e-mail recebe avisos do Let's Encrypt)
EJMF_DOMINIO=
EJMF_ACME_EMAIL=
EJMF_URL_PUBLICA=https://
# Banco: senha forte e única (não use a de exemplo)
POSTGRES_USER=ejmf
POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
EJMF_CHAVE_SECRETA=
# python -m app.cli gerar-chave-backup  — guarde também FORA do servidor
EJMF_BACKUP_CHAVE=
# Pastas em OUTRO disco do servidor (cópias cifradas e WAL)
EJMF_COPIAS_DIR=
EJMF_WAL_DIR=
EJMF_WAL_HORA=03:00
EJMF_WAL_BASES=7
# Cópia externa (S3 compatível). Credencial só com gravar e ler; retenção pela regra do bucket.
EJMF_BACKUP_S3_ENDPOINT=
EJMF_BACKUP_S3_REGIAO=
EJMF_BACKUP_S3_BUCKET=
EJMF_BACKUP_S3_CHAVE_ACESSO=
EJMF_BACKUP_S3_CHAVE_SECRETA=
# Integrações: preencha só as que o escritório contratar (ver INTEGRATIONS.md); vazio = "aguardando credenciais"
EJMF_FUSO_HORARIO=America/Fortaleza
