# Copie para .env e ajuste. Nunca versione o .env.
# ---------------------------------------------------------------- banco
POSTGRES_USER=ejmf
POSTGRES_PASSWORD=troque-esta-senha
EJMF_DB_PORTA=5432

# ---------------------------------------------------------------- aplicação
# desenvolvimento | homologacao | producao
EJMF_AMBIENTE=desenvolvimento
# Fora do desenvolvimento: no mínimo 32 caracteres aleatórios (ex.: python -c "import secrets;print(secrets.token_urlsafe(48))")
# Trocar esta chave encerra todas as sessões e invalida segredos de MFA cifrados.
EJMF_CHAVE_SECRETA=
EJMF_FUSO_HORARIO=America/Fortaleza
EJMF_MFA_OBRIGATORIO_ADMIN=false
EJMF_SESSAO_INATIVIDADE_MINUTOS=480
EJMF_SESSAO_ABSOLUTA_HORAS=168

# ---------------------------------------------------------------- integrações (preencher nas fases correspondentes)
# DataJud: chave pública publicada em https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
# Google (Gmail e Agenda) — OAuth do escritório
EJMF_GOOGLE_CLIENT_ID=
EJMF_GOOGLE_CLIENT_SECRET=
EJMF_GOOGLE_REDIRECT_URI=
# WhatsApp Business Cloud API
EJMF_WHATSAPP_TOKEN=
EJMF_WHATSAPP_PHONE_NUMBER_ID=
EJMF_WHATSAPP_APP_SECRET=
EJMF_WHATSAPP_VERIFY_TOKEN=
# Assinatura eletrônica (Documenso): chave da API e segredo do webhook (/api/v1/publico/documenso/webhook)
EJMF_DOCUMENSO_TOKEN=
EJMF_DOCUMENSO_URL=https://app.documenso.com/api/v2
EJMF_DOCUMENSO_WEBHOOK_SECRET=
# Ferramentas de documentos (já instaladas na imagem Docker)
EJMF_TESSERACT_BIN=tesseract
EJMF_SOFFICE_BIN=soffice
# Provedores de IA (somente após aprovação do tratamento de dados)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Notificações no celular (Web Push). Gere com: python -m app.cli gerar-vapid (a chave privada nunca vai para o código)
EJMF_VAPID_CHAVE_PUBLICA=
EJMF_VAPID_CHAVE_PRIVADA=
EJMF_VAPID_CONTATO=
# Cópias de segurança (Fase 11). Gere com: python -m app.cli gerar-chave-backup e guarde a chave TAMBÉM fora do servidor
EJMF_BACKUP_CHAVE=
EJMF_BACKUP_DIR=dados/backups
# Antivírus (opcional): socket do clamd (/run/clamav/clamd.ctl) ou tcp://clamav:3310 com o perfil "antivirus" do compose
EJMF_CLAMAV_ENDERECO=
