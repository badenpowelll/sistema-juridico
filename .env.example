# Copie para .env no desenvolvimento. Em produção, defina estas variáveis no Railway (aba Variables).
# Nunca coloque valores reais no repositório.

# Postgres. No Railway, use a referência ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sistema_juridico

# Porta do servidor (o Railway define sozinho).
PORT=3000

# Endereço público do sistema, usado nos links de formulário e no retorno do login da Microsoft.
URL_PUBLICA=http://localhost:3000

# Primeiro administrador (usado só por `npm run criar-admin`).
ADMIN_EMAIL=
ADMIN_NOME=
ADMIN_OAB=

# OneDrive (Microsoft Graph). Registro do aplicativo em entra.microsoft.com.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "consumers" para OneDrive pessoal, "organizations" ou o id do locatário para Microsoft 365.
MS_TENANT=consumers
# Pasta raiz no OneDrive de onde o sistema puxa os dados.
ONEDRIVE_PASTA_RAIZ=Clientes

# Chave para cifrar segredos guardados no banco (refresh token do OneDrive). Gere com: openssl rand -base64 32
CHAVE_CRIPTOGRAFIA=
